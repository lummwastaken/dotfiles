{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
	  "type": "auto",
	  "source": "blackmesa",
	  "color": {
		  "1": "light_yellow"
	  }
  },
  "display": {
	  "separator": ": ",
	  "color": {
		  "keys": "yellow",
		  "title": "light_yellow"
	  },
	  "key": {
		  "type": "both"
	  },
	  "bar": {
		  "width": 10,
		  "char": {
			  "elapsed": "■",
			  "total": "+"
		  }
	  },
	  "percent": {
		  "type": 3,
		  "color": {
			  "green": "white",
			  "yellow": "light_yellow",
			  "red": "light_red"
		  }
	  }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "separator",
    "de",
    "theme",
    "wm",
    "wmtheme",
    "icons",
    "font",
    "cursor",
    "separator",
    "version",
    "break",
    "colors",
  ]
}
